{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "defaultMode": "default",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch feature/*)",
      "Bash(git switch -c feature/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin feature/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(sf project retrieve start *)",
      "Bash(sf org list *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch feature/*)",
      "PowerShell(git switch -c feature/*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push -u origin feature/*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(sf project retrieve start *)",
      "PowerShell(sf org list *)"
    ],
    "ask": [
      "Bash(sf project deploy start *)",
      "PowerShell(sf project deploy start *)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "mcp__atlassian"
    ],
    "deny": [
      "Bash(git push origin develop*)",
      "Bash(git push origin main*)",
      "Bash(git push *:develop*)",
      "Bash(git push *:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh api *)",
      "Bash(sf org login *)",
      "Bash(sf org logout *)",
      "Bash(sf org delete *)",
      "Bash(sf project deploy quick *)",
      "Bash(sf project deploy resume *)",
      "Bash(sf project delete *)",
      "Bash(sf apex run *)",
      "Bash(sf data delete *)",
      "Bash(sf data update *)",
      "Bash(sf data upsert *)",
      "Bash(sf data import *)",
      "PowerShell(git push origin develop*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push *:develop*)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git commit -n *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh api *)",
      "PowerShell(sf org login *)",
      "PowerShell(sf org logout *)",
      "PowerShell(sf org delete *)",
      "PowerShell(sf project deploy quick *)",
      "PowerShell(sf project deploy resume *)",
      "PowerShell(sf project delete *)",
      "PowerShell(sf apex run *)",
      "PowerShell(sf data delete *)",
      "PowerShell(sf data update *)",
      "PowerShell(sf data upsert *)",
      "PowerShell(sf data import *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.sf/**)",
      "Read(./.sfdx/**)",
      "Read(~/.sf/**)",
      "Read(~/.sfdx/**)"
    ]
  }
}
